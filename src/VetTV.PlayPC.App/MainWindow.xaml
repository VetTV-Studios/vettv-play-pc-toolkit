<Window x:Class="VetTV.PlayPC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VetTV Play PC Toolkit" Height="680" Width="1000">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Disclaimer}" Opacity="0.7" Margin="0,8,0,0"/>
    <TabControl>
      <TabItem Header="Diagnose">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Run diagnostics" Command="{Binding RunCommand}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="Export diagnostics zip..." Command="{Binding ExportCommand}" Padding="12,4" Margin="0,0,16,0"/>
            <CheckBox Content="Redact user names / emails" IsChecked="{Binding Redact}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <CheckBox Content="Include DxDiag" IsChecked="{Binding IncludeDxDiag}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0"/>
          <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="60"/>
              <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="80"/>
              <DataGridTextColumn Header="Check" Binding="{Binding Title}" Width="200"/>
              <DataGridTemplateColumn Header="Details / fix" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding FixHint, StringFormat=Fix: {0}}" TextWrapping="Wrap" Foreground="DarkOrange"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Fix" DataContext="{Binding Fix}">
        <ScrollViewer Margin="8">
          <StackPanel>
            <TextBlock Text="Windows features (asks for administrator permission, then a restart)" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Features}" Margin="0,4,0,12">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Content="{Binding StringFormat=Enable {0}...}" Margin="0,2" HorizontalAlignment="Left" Padding="10,3"
                        Command="{Binding DataContext.EnableFeatureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Performance presets (each can be undone)" FontWeight="Bold"/>
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,4,0,12">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                  <CheckBox IsChecked="{Binding Applied, Mode=OneWay}" IsEnabled="False" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Info.Title}" Width="260" Margin="6,0" VerticalAlignment="Center" ToolTip="{Binding Info.Description}"/>
                  <Button Content="Apply / Undo" Padding="10,2"
                          Command="{Binding DataContext.TogglePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="In Google Play Games itself: open Settings and choose the display and graphics options there. The toolkit never edits its files."/>
            <TextBlock Text="Heavy background apps" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4">
              <Button Content="Scan" Command="{Binding ScanHeavyAppsCommand}" Padding="10,2" Margin="0,0,8,0"/>
              <Button Content="Ask selected app to close" Command="{Binding CloseSelectedAppCommand}" Padding="10,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding HeavyApps}" SelectedItem="{Binding SelectedApp}" DisplayMemberPath="Title" Height="120"/>
            <TextBlock Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Launch" DataContext="{Binding Fix}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Refresh" Command="{Binding RefreshGamesCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Play" Command="{Binding LaunchGameCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Copy to Desktop" Command="{Binding CopyToDesktopCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Add to Steam..." Command="{Binding AddToSteamCommand}" Padding="10,3"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0"/>
          <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Name"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Clean &amp; Backup" DataContext="{Binding Fix}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Preview cache" Command="{Binding PreviewCacheCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Send to Recycle Bin..." Command="{Binding CleanCacheCommand}" Padding="10,3" Margin="0,0,24,0"/>
            <Button Content="Back up toolkit settings..." Command="{Binding BackupCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Restore..." Command="{Binding RestoreCommand}" Padding="10,3"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0"/>
          <DataGrid ItemsSource="{Binding CacheFiles}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*"/>
              <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Developer Emulator" DataContext="{Binding Developer}">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Disclaimer}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,8"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Connect" Command="{Binding ConnectCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Refresh apps" Command="{Binding RefreshPackagesCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Install APK/AAB..." Command="{Binding InstallCommand}" Padding="10,3" Margin="0,0,8,0"/>
            <Button Content="Uninstall selected" Command="{Binding UninstallCommand}" Padding="10,3" Margin="0,0,16,0"/>
            <TextBlock Text="bundletool.jar:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding BundletoolPath}" Width="200" Margin="0,0,4,0"/>
            <Button Content="..." Command="{Binding BrowseBundletoolCommand}" Padding="6,2"/>
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" Margin="0,0,8,0"/>
            <DockPanel Grid.Column="1">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Logcat filter (e.g. MyGame:D *:S):" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Text="{Binding LogFilter}" Width="180" Margin="0,0,8,0"/>
                <Button Content="Start / stop logcat" Command="{Binding ToggleLogcatCommand}" Padding="10,2"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11" VirtualizingPanel.IsVirtualizing="True"/>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Controller tips" DataContext="{Binding Developer}">
        <ScrollViewer Margin="8">
          <ItemsControl ItemsSource="{Binding Tips}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
